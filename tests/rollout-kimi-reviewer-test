#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_dir="$(mktemp -d)"
trap 'rm -rf "$test_dir"' EXIT

cat > "$test_dir/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  "auth status --hostname github.com")
    exit 0
    ;;
  "api user --jq .login")
    echo "theomantz"
    ;;
  "repo list "*)
    printf 'theomantz/example\tmain\n'
    ;;
  *"contents/.github/workflows/kimi-review.yml?ref=main --jq .content")
    if [[ "${TEST_CURRENT_WORKFLOW:-false}" == true ]]; then
      base64 < "$TEST_WORKFLOW_TEMPLATE"
    else
      exit 1
    fi
    ;;
  "api --paginate repos/theomantz/example/rulesets "*)
    echo "42"
    ;;
  "api repos/theomantz/example/rulesets/42")
    printf '%s\n' '{"id":42,"name":"review","target":"branch","enforcement":"active","conditions":{},"rules":[{"type":"copilot_code_review","parameters":{"review_on_push":true}},{"type":"deletion"}],"source_type":"Repository"}'
    ;;
  *)
    echo "Unexpected gh call: $*" >&2
    exit 1
    ;;
esac
EOF
chmod +x "$test_dir/gh"

export TEST_WORKFLOW_TEMPLATE="$repo_root/github/workflows/kimi-review.yml"

new_output="$(
  PATH="$test_dir:$PATH" \
    "$repo_root/scripts/rollout-kimi-reviewer" --dry-run
)"
grep -F "would set KIMI_API_KEY" <<<"$new_output" >/dev/null
grep -F "would open chore/kimi-reviewer -> main" <<<"$new_output" >/dev/null
grep -F "Copilot rules stay enabled until the workflow is merged" \
  <<<"$new_output" >/dev/null

current_output="$(
  TEST_CURRENT_WORKFLOW=true PATH="$test_dir:$PATH" \
    "$repo_root/scripts/rollout-kimi-reviewer" --dry-run
)"
grep -F "Kimi workflow is current on main" <<<"$current_output" >/dev/null
grep -F "would remove Copilot review from ruleset 42" \
  <<<"$current_output" >/dev/null

if PATH="$test_dir:$PATH" \
  "$repo_root/scripts/rollout-kimi-reviewer" --repo theomantz/example \
  >/dev/null 2>&1; then
  echo "Live rollout unexpectedly succeeded without KIMI_API_KEY" >&2
  exit 1
fi

echo "rollout-kimi-reviewer tests passed"
